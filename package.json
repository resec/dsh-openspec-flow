{
  "name": "dsh-openspec-flow",
  "version": "0.7.0",
  "private": true,
  "description": "Token-efficient OpenSpec workflow tools, reviews, and a review settings page for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "=0.2.2-rc.2"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./reviewer": "./reviewer.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**",
    "reviewer.js",
    "skills/**",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs plugin",
    "test:affected": "node scripts/affected-tests.mjs --run",
    "verify": "node scripts/coverage.mjs --check",
    "coverage": "node scripts/coverage.mjs",
    "coverage:check": "node scripts/coverage.mjs --check",
    "coverage:baseline": "node scripts/coverage.mjs --update-baseline",
    "contract:check": "node scripts/check-cli-contract.mjs",
    "openspec:check": "openspec validate --all --strict && openspec validate --archived --strict",
    "hooks:install": "node scripts/install-hooks.mjs",
    "bundle:pack": "node scripts/bundle-pack.mjs"
  },
  "dependencies": {
    "@fission-ai/openspec": "2.0.0"
  }
}
