{
  "name": "dsh-openspec-flow",
  "version": "0.1.0",
  "private": true,
  "description": "Token-efficient OpenSpec workflow tools and an apply skill for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "=0.2.2-rc.1"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "lib/**",
    "skills/**",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs plugin",
    "test:eval": "node scripts/run-tests.mjs eval",
    "test:all": "node scripts/run-tests.mjs all",
    "coverage": "node scripts/coverage.mjs",
    "coverage:check": "node scripts/coverage.mjs --check",
    "coverage:baseline": "node scripts/coverage.mjs --update-baseline",
    "hooks:install": "node scripts/install-hooks.mjs",
    "eval:dry": "node eval/run.mjs",
    "eval:pilot": "node eval/run.mjs --execute --runs 1",
    "eval:matrix": "node eval/run.mjs --execute",
    "eval:clean": "node eval/clean.mjs"
  },
  "dependencies": {
    "@fission-ai/openspec": "1.16.0"
  }
}
