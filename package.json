{
  "name": "dsh-openspec-flow",
  "version": "0.3.1",
  "private": true,
  "description": "Token-efficient OpenSpec workflow tools and an apply skill for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "=0.2.2-rc.2"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./reviewer": "./reviewer.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "lib/**",
    "reviewer.js",
    "skills/**",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs plugin",
    "coverage": "node scripts/coverage.mjs",
    "coverage:check": "node scripts/coverage.mjs --check",
    "coverage:baseline": "node scripts/coverage.mjs --update-baseline",
    "contract:check": "node scripts/check-cli-contract.mjs",
    "openspec:check": "openspec validate --all --strict && openspec validate --archived --strict",
    "hooks:install": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@fission-ai/openspec": "1.16.1"
  }
}
