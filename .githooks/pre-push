#!/bin/sh
# Local gates: strict OpenSpec validation, then the verification entrypoint.
# A push whose only destination is main validates main specs and archived tasks
# and requires every active change to be in progress; a push to another or a
# mixed set of refs keeps the full check.
# The coverage stamp may skip a repeat of the verification entrypoint when the
# same committed inputs already passed it; COVERAGE_SKIP=1 skips only coverage.
# The reusable DSH lab scenarios run in the remote lab CI job, not here; the
# offline local path runs them before landing. Requires node on PATH; no
# version manager is invoked.
saw_ref=0
only_main=1
main_local_sha=
main_remote_sha=
# Git supplies the refs on a pipe. A terminal stdin has no refs, so it takes
# the fallback instead of waiting for a line.
if [ ! -t 0 ]; then
  while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    saw_ref=1
    if [ "$remote_ref" != "refs/heads/main" ]; then
      only_main=0
    else
      main_local_sha=$local_sha
      main_remote_sha=$remote_sha
    fi
  done
fi
if [ "$saw_ref" = "1" ] && [ "$only_main" = "1" ]; then
  npm run openspec:check:push || exit $?
else
  npm run openspec:check || exit $?
fi
if [ "$saw_ref" = "1" ] && [ -n "$main_local_sha" ]; then
  case "$main_local_sha" in
    0000000000000000000000000000000000000000) : ;;
    *) node scripts/check-main-push.mjs "$main_local_sha" "$main_remote_sha" || exit $? ;;
  esac
fi
if [ "${COVERAGE_SKIP:-}" = "1" ]; then
  echo "coverage gate: skipped because COVERAGE_SKIP=1" >&2
  exit 0
fi
if node scripts/coverage-stamp.mjs check; then
  exit 0
fi
exec npm run verify
